# ==============================================================================
# Briefin Configuration (.env)
# ==============================================================================

# Sectors API Key (Get from https://sectors.app)
SECTORS_API_KEY=your_sectors_api_key_here

# AI Summarization Key (Use Gemini or Anthropic)
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_claude_api_key_here

# ------------------------------------------------------------------------------
# WhatsApp Configuration (Self-Hosted Baileys Gateway - Recommended)
# ------------------------------------------------------------------------------
# URL of local/remote Baileys Gateway (default: http://localhost:3000)
WA_GATEWAY_URL=http://localhost:3000
# Target WhatsApp number (format: 08xxxxxxxxxx or 628xxxxxxxxxx) or Group JID
WHATSAPP_TARGET=081234567890

# (Optional Fallback) Fonnte API Token
# FONNTE_TOKEN=your_fonnte_token_here

# ------------------------------------------------------------------------------
# Telegram Configuration (Optional)
# ------------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here
